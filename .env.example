# Discord bot authentication
DISCORD_TOKEN=

# Privileged access configuration.
# Use comma-separated Discord user IDs and/or role IDs.
# At least one of these lists must contain a valid Discord ID.
# Store actual values in the host's environment settings or in your ignored local .env.
ADMIN_USER_IDS=
ADMIN_ROLE_IDS=

# Gemini API keys
# At least GEMINI_API_KEY is required.
# GEMINI_API_KEY_2 through GEMINI_API_KEY_4 provide failover keys when configured.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Optional Minecraft account password.
# The current bot uses offline authentication, so leave this blank unless the
# Minecraft authentication mode is intentionally changed.
MC_PASSWORD=

# Optional Discord channel for private error reports.
ERROR_CHANNEL_ID=


# Public read-only Minecraft status API
# WispByte may provide PORT automatically; STATUS_PORT is a fallback.
STATUS_PORT=3000

# Comma-separated website origins allowed to read /api/status.
# Use the exact website origin. Add more comma-separated origins only when needed.
# Do not use * unless cross-origin access from every website is intentional.
STATUS_ALLOWED_ORIGINS=https://the-cottage.onrender.com
